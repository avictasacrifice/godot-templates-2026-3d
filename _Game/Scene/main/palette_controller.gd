@export_enum("1bit", "gameboy", "pico8", "sweetie16", "c64", "ega", "zx", "custom") var palette_mode: String = "pico8"
@export var custom_palette: Array[Color] = []

func _ready() -> void:
	# Автоматически создаем материал, если его нет
	if material == null:
		material = ShaderMaterial.new()
		material.shader = load("res://dither.gdshader") # Убедись, что путь верный!
		
	_apply_palette(_resolve_palette())

func _resolve_palette() -> Array[Color]:
	if palette_mode == "custom":
		return custom_palette
	
	var colors: Array[Color] = []
	colors.assign(PRESETS.get(palette_mode, PRESETS["1bit"]))
	return colors

func _apply_palette(colors: Array[Color]) -> void:
	var arr := PackedVector3Array()
	for i in mini(colors.size(), MAX_PALETTE):
		var c := colors[i]
		arr.append(Vector3(c.r, c.g, c.b))
		
	while arr.size() < MAX_PALETTE:
		arr.append(Vector3.ZERO)
		
	if material is ShaderMaterial:
		material.set_shader_parameter("palette", arr)
		material.set_shader_parameter("palette_size", mini(colors.size(), MAX_PALETTE))
